# NB idb Homebrew formula — generated by release/release.sh from
# release/formula/idb.rb.tmpl (placeholders: VERSION, COMPANION_URL/SHA,
# WHEELHOUSE_URL/SHA). Installs both halves (idb_companion + the fb-idb client)
# so the client and companion stay in lockstep on the pinned proto.
class Idb < Formula
  desc "Notability build of the iOS Debug Bridge client and companion"
  homepage "https://github.com/Ginger-Labs/idb"
  # Primary download: the self-contained macOS companion bundle (idb_companion +
  # idb-repl + shim dylibs + SimulatorFrameworkBridge). Currently arm64-only;
  # rebuild universal and re-render to widen support.
  url "@@COMPANION_URL@@"
  version "@@VERSION@@"
  sha256 "@@COMPANION_SHA@@"
  license "MIT"

  depends_on :macos # companion links Apple's private CoreSimulator frameworks
  depends_on "python@3.12" # client uses asyncio.get_event_loop(), gone in 3.13+

  # Deliberately NO `conflicts_with "idb-companion"`: modern Homebrew refuses to
  # load a conflicting formula from an untrusted tap (facebook/fb), which would
  # break `brew install` for exactly our migration audience — anyone who has that
  # tap. Homebrew's keg linking already blocks two formulae from owning the same
  # `idb_companion` binary; RELEASING.md covers uninstalling the upstream one.

  # Self-contained wheelhouse: the client wheel + all its dependencies, so the
  # install works inside Homebrew's network-restricted build sandbox (no PyPI).
  resource "client-wheelhouse" do
    url "@@WHEELHOUSE_URL@@"
    sha256 "@@WHEELHOUSE_SHA@@"
  end

  def install
    # 1) Companion bundle -> libexec; expose idb_companion on PATH via a symlink.
    #    The bundle is relocatable: its rpaths are @executable_path-relative, and
    #    @executable_path (and Bundle.main) resolve through the bin symlink to the
    #    real libexec location, so the sibling Resources/ and *.bundle are found.
    libexec.install Dir["*"]
    bin.install_symlink libexec/"idb_companion"

    # 2) Python client -> a self-contained venv in libexec; expose `idb` on PATH.
    #    Install entirely from the bundled wheelhouse (offline, reproducible).
    #    A plain `python -m venv` (which has pip) is used rather than Homebrew's
    #    virtualenv_create, whose --without-pip venv has no venv/bin/pip to drive
    #    an offline --find-links install.
    python = Formula["python@3.12"].opt_bin/"python3.12"
    venv_dir = libexec/"venv"
    system python, "-m", "venv", venv_dir
    wheelhouse = buildpath/"wheelhouse"
    resource("client-wheelhouse").stage(wheelhouse)
    system venv_dir/"bin/pip", "install", "--no-index", "--find-links", wheelhouse, "fb-idb"
    bin.install_symlink venv_dir/"bin/idb"
  end

  test do
    # Companion reports the NB version (returns before touching CoreSimulator).
    assert_match "@@VERSION@@", shell_output("#{bin}/idb_companion --version")
    # Client imports and its CLI parses (the new pinch command is present).
    system bin/"idb", "ui", "pinch", "--help"
  end
end
